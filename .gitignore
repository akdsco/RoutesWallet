# Repo-level ignores. Each app (mobile/, web/) also has its own .gitignore.
node_modules/
.DS_Store
*.log

# git worktrees created by `git wt-new`
.worktrees/

# env / secrets
.env
.env.*
!.env.example

# build outputs
dist/
build/

# ephemeral /ship working files — per-branch, never committed
docs/ship-reviews/
docs/ship-playbook.md
